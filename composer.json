{
    "name": "islandora/crayfish-commons",
    "description": "Shared code amongst Islandora Crayfish microservices",
    "type": "symfony-bundle",
    "homepage": "https://github.com/Islandora/Crayfish-Commons",
    "support": {
        "issues": "https://github.com/Islandora/documentation/issues"
    },
    "require": {
        "islandora/chullo": "^2.0",
        "php": "^8.4.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "symfony/config": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "phpspec/prophecy-phpunit": "^2.5",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/phpunit-bridge": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "Islandora\\Crayfish\\Commons\\": ""
        }
    },
    "scripts": {
        "check": [
            "phpcs --standard=PSR2 --extensions=php --ignore=\"vendor/\" ."
        ],
        "test": [
            "@check",
            "phpunit"
        ],
        "coverage": "phpunit --coverage-clover clover.xml"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Islandora Foundation",
            "email": "community@islandora.ca",
            "role": "Owner"
        },
        {
            "name": "Daniel Lamb",
            "email": "dlamb@islandora.ca",
            "role": "Maintainer"
        }
    ]
}
